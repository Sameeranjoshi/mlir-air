#!/usr/bin/env bash
# Pre-push hook — runs full CSL test suite (Tier 1 lit + Tier 2 simulator)
# before every `git push`.  Blocks the push on any failure.
#
# Enable with:
#   git config core.hooksPath .githooks
#
# Bypass for a single push (WIP, docs-only, etc.):
#   git push --no-verify
#
# During development, use these same entry points manually:
#   bash utils/run_csl_ci.sh --fast --no-build          # <1s, lit only
#   bash utils/run_csl_ci.sh --no-build --only=fadds_e2e # single wafer
#   bash utils/run_csl_ci.sh --no-build -j 8            # same as this hook
set -e
echo "Running CSL CI before push (lit + simulator, ~51s at -j 8)..."
exec "$(git rev-parse --show-toplevel)/utils/run_csl_ci.sh" --no-build -j 8
