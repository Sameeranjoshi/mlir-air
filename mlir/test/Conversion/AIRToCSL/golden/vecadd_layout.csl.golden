// Golden reference CSL layout for the AIR → CSL vecadd milestone.
// This file is hand-written and verified to compile and run on CS-3.
// The KernelEmitter in CSLRuntimeToPy.cpp must produce output equivalent to
// the layout + pe_program pair.

const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });

layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "vecadd_pe.csl", .{ .memcpy_params = memcpy.get_params(0) });

  // Export symbol names so the host can reference them by name.
  @export_name("a", [*]f32, true);
  @export_name("b", [*]f32, true);
  @export_name("c", [*]f32, false);
  @export_name("compute", fn()void);
}
